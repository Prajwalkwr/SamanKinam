{
  "installCommand": "MONGOMS_DISABLE_POSTINSTALL=1 npm install && npm install --prefix ../client",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "regions": ["bom1"],
  "functions": {
    "api/index.js": { "maxDuration": 60, "includeFiles": "data/**" }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
